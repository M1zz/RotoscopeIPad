    "한 번 결제로 팔랑북의 모든 기능을 계속 쓸 수 있어요.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einmal kaufen und alle Funktionen von Palang Book dauerhaft nutzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One purchase unlocks everything in Palang Book, for good."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con un solo pago, todo Palang Book es tuyo para siempre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un seul achat débloque tout Palang Book, pour toujours."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con un solo acquisto sblocchi tutto Palang Book, per sempre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一度の購入で、Palang Bookのすべての機能をずっと使えます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com um único pagamento, todo o Palang Book é seu para sempre."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一次购买，即可永久使用 Palang Book 的全部功能。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一次購買，即可永久使用 Palang Book 的全部功能。"
          }
        }
      }
    },
    "한 번만 결제하고 구독이 아니에요. 결제는 App Store 계정으로 청구됩니다.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einmalige Zahlung, kein Abo. Die Abrechnung erfolgt über deinen App Store-Account."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One-time payment, not a subscription. Charged to your App Store account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pago único, no es una suscripción. Se cobrará a tu cuenta del App Store."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paiement unique, sans abonnement. Le montant est débité de votre compte App Store."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pagamento unico, non è un abbonamento. L'addebito avviene sull'account App Store."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1回限りのお支払いで、サブスクリプションではありません。お支払いはApp Storeアカウントに請求されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pagamento único, não é assinatura. A cobrança é feita na sua conta da App Store."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一次性付款，并非订阅。费用将计入你的 App Store 账户。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一次性付款，並非訂閱。費用將向你的 App Store 帳號收取。"
          }
        }
      }
    }
  },
