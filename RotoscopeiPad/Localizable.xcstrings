    "움직임 줄이기를 켜면 화면 효과가 차분해져요.": {
      "comment": "Roadmap item detail: reduce motion",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Se zapnutou volbou Omezit pohyb jsou animace klidnější."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Med Reducer bevægelse slået til bliver animationerne mere rolige."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ist „Bewegung reduzieren“ aktiv, werden Animationen ruhiger."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Με ενεργή τη Μείωση κίνησης, τα εφέ στην οθόνη γίνονται πιο ήρεμα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With Reduce Motion on, animations become calmer."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "With Reduce Motion on, animations become calmer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con Reducir movimiento activado, las animaciones son más suaves."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun Vähennä liikettä on päällä, näytön tehosteet rauhoittuvat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec Réduire les animations activé, les effets se font plus discrets."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat Kurangi Gerakan aktif, efek di layar menjadi lebih tenang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con Riduci movimento attivo, le animazioni diventano più tranquille."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「視差効果を減らす」をオンにすると、画面の動きが控えめになります。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Med Reduser bevegelse på blir animasjonene roligere."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Met Beweging beperken aan worden effecten op het scherm rustiger."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po włączeniu opcji Ogranicz ruch efekty na ekranie stają się spokojniejsze."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com Reduzir Movimento ativado, as animações ficam mais suaves."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда включено «Уменьшение движения», эффекты на экране становятся спокойнее."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Med Reducera rörelse på blir animationerna lugnare."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อเปิดลดการเคลื่อนไหว เอฟเฟกต์บนหน้าจอจะนุ่มนวลขึ้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hareketi Azalt açıkken ekrandaki efektler daha sakin olur."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi bật Giảm chuyển động, các hiệu ứng trên màn hình sẽ dịu hơn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开“减弱动态效果”后，界面动画会更柔和。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟「減少動態效果」後，畫面動畫會更柔和。"
          }
        }
      }
    },
    "원하면 앱 안의 작품을 한 번에 모두 지울 수 있어요.": {
      "comment": "Roadmap item detail: delete all data",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Smažte všechna díla v aplikaci najednou, kdykoli budete chtít."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slet alle værker i appen på én gang, når du vil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lösche bei Bedarf alle Werke in der App in einem Schritt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διαγράψτε όλα τα έργα της εφαρμογής με μία κίνηση, όποτε θέλετε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Erase every artwork in the app in one go whenever you want."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Erase every artwork in the app in one go whenever you want."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Borra todas las obras de la app de una sola vez cuando quieras."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Poista kaikki apin teokset kerralla milloin haluat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Effacez en une fois toutes les œuvres de l’app quand vous le souhaitez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
