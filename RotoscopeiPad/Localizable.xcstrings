    "재생하면 그림이 팔랑팔랑 움직여요. 목소리를 넣고 사진 앱에 저장해요": {
      "comment": "First-run guide, step 3: play, record a voice, save to Photos",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Stiskni přehrát a kresby ožijí. Přidej svůj hlas a ulož do Fotek."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på afspil, så vokser dine tegninger til live. Tilføj din stemme, og gem i Fotos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drück auf Abspielen und deine Bilder bewegen sich. Sprich etwas dazu und sichere es in Fotos."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πάτα αναπαραγωγή και τα σχέδιά σου ζωντανεύουν. Πρόσθεσε τη φωνή σου και αποθήκευσε στις Φωτογραφίες."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press play and your drawings come to life. Add your voice and save it to Photos."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Press play and your drawings come to life. Add your voice and save it to Photos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dale a reproducir y tus dibujos cobran vida. Añade tu voz y guárdalo en Fotos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Paina toista, niin piirroksesi heräävät eloon. Lisää äänesi ja tallenna Kuviin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuie sur lecture et tes dessins prennent vie. Ajoute ta voix et enregistre le tout dans Photos."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekan putar dan gambarmu bergerak. Tambahkan suaramu lalu simpan ke Foto."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Premi play e i tuoi disegni prendono vita. Aggiungi la tua voce e salva in Foto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再生すると絵がパラパラ動きだす。声を入れて写真に保存しよう。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk på spill av, så våkner tegningene dine til liv. Legg til stemmen din og lagre i Bilder."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Druk op afspelen en je tekeningen komen tot leven. Voeg je stem toe en bewaar in Foto’s."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naciśnij odtwarzanie, a rysunki ożyją. Dodaj swój głos i zapisz w Zdjęciach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperte o play e seus desenhos ganham vida. Grave sua voz e salve no Fotos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите «Воспроизвести» — рисунок оживёт. Добавьте голос и сохраните в «Фото»."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på spela upp så väcks teckningarna till liv. Lägg till din röst och spara i Bilder."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กดเล่นแล้วภาพวาดของคุณจะขยับ ใส่เสียงของคุณและบันทึกลงรูปภาพได้เลย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oynat'a bas, çizimlerin canlansın. Sesini ekle ve Fotoğraflar'a kaydet."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhấn phát và tranh của bạn sẽ chuyển động. Thêm giọng nói rồi lưu vào Ảnh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点播放，画就动起来啦。还能配上声音，存到“照片”里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點播放，畫就動起來囉。還能配上聲音，存到「照片」裡。"
          }
        }
      }
    },
