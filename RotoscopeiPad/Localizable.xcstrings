    "동영상을 가져오면 시작할 수 있어요!": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hol dir ein Video, dann geht's los!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring in a video to get started!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Trae un video para empezar!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Importe une vidéo pour commencer !"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Importa un video per cominciare!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "動画を読み込んだら始められるよ！"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Traga um vídeo para começar!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导入视频就可以开始啦！"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "匯入影片就可以開始囉！"
          }
        }
      }
    },
    "동영상을 가져오지 못했어요: %@": {
      "localizations": {
