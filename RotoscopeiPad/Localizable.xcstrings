    "마이크를 누르면 그림이 한 번 재생되는 동안 목소리를 녹음해요.": {
      "comment": "Tip message over the microphone button",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnutím na mikrofon nahrajete svůj hlas, zatímco se animace jednou přehraje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på mikrofonen for at optage din stemme, mens animationen afspilles én gang."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf das Mikrofon: Während die Animation einmal läuft, wird deine Stimme aufgenommen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πατήστε το μικρόφωνο για να ηχογραφήσετε τη φωνή σας ενώ η κινούμενη εικόνα παίζει μία φορά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the microphone to record your voice while the animation plays once."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the microphone to record your voice while the animation plays once."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca el micrófono para grabar tu voz mientras la animación se reproduce una vez."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Napauta mikrofonia, niin äänesi tallentuu animaation toistuessa kerran."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touche le micro pour enregistrer ta voix pendant que l'animation se joue une fois."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk mikrofon untuk merekam suaramu saat animasi diputar satu kali."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca il microfono per registrare la tua voce mentre l'animazione va una volta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マイクをおすと、アニメが1回流れるあいだ声を録音できるよ。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk på mikrofonen for å ta opp stemmen din mens animasjonen spilles av én gang."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op de microfoon om je stem op te nemen terwijl de animatie één keer afspeelt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dotknij mikrofonu, aby nagrać swój głos, gdy animacja odtwarza się jeden raz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque no microfone para gravar sua voz enquanto a animação toca uma vez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите на микрофон, чтобы записать голос, пока анимация проигрывается один раз."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på mikrofonen för att spela in din röst medan animationen spelas upp en gång."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะไมโครโฟนเพื่อบันทึกเสียงของคุณขณะที่ภาพเคลื่อนไหวเล่นหนึ่งรอบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Animasyon bir kez oynarken sesini kaydetmek için mikrofona dokun."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm vào micrô để ghi giọng nói của bạn trong lúc hoạt hình chạy một lượt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点麦克风，动画播放一遍的时候就能录下你的声音。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點麥克風，動畫播放一遍的時候就能錄下你的聲音。"
          }
        }
      }
    },
