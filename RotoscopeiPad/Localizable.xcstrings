    "열지 못했어요. 동영상 링크인지 확인해 주세요.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepodařilo se otevřít. Ujistěte se, že jde o odkaz na video."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke åbnes. Kontrollér, at det er et videolink."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Konnte nicht geöffnet werden. Ist das ein Videolink?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν ήταν δυνατό το άνοιγμα. Βεβαιωθείτε ότι είναι σύνδεσμος βίντεο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't open it. Make sure it's a video link."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't open it. Make sure it's a video link."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo abrir. Comprueba que sea un enlace de video."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaaminen ei onnistunut. Varmista, että kyseessä on videolinkki."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d'ouvrir. Vérifiez qu'il s'agit d'un lien vidéo."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak bisa dibuka. Pastikan itu tautan video."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile aprire. Controlla che sia un link a un video."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開けませんでした。動画のリンクか確認してください。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke åpnes. Kontroller at det er en videolenke."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Openen mislukt. Controleer of het een videolink is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się otworzyć. Upewnij się, że to link do filmu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível abrir. Confira se é um link de vídeo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось открыть. Убедитесь, что это ссылка на видео."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det gick inte att öppna. Kontrollera att det är en videolänk."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดไม่ได้ โปรดตรวจสอบว่าเป็นลิงก์วิดีโอ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Açılamadı. Bunun bir video bağlantısı olduğundan emin ol."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không mở được. Hãy kiểm tra xem đó có phải liên kết video không."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法打开。请确认这是视频链接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法開啟。請確認這是影片連結。"
          }
        }
      }
    },
    "열지 못했어요. 링크를 확인하고 다시 해보세요.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepodařilo se otevřít. Zkontrolujte odkaz a zkuste to znovu."
          }
        },
        "da": {
          "stringUnit": {
