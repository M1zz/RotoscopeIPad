    "대비를 높이거나 색을 구별하기 어려워도 내용을 알아볼 수 있어요.": {
      "comment": "Roadmap item detail: contrast and color",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vše zůstane čitelné se zvýšeným kontrastem i když je obtížné rozlišit barvy."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alt forbliver læseligt med øget kontrast, eller hvis farver er svære at skelne."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles bleibt lesbar – mit erhöhtem Kontrast oder wenn Farben schwer zu unterscheiden sind."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όλα παραμένουν ευανάγνωστα με αυξημένη αντίθεση ή όταν είναι δύσκολο να ξεχωρίσετε τα χρώματα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything stays readable with Increase Contrast on or if colors are hard to tell apart."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything stays readable with Increase Contrast on or if colours are hard to tell apart."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo se lee bien con más contraste o si te cuesta distinguir colores."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaikki pysyy luettavana, kun Lisää kontrastia on päällä tai jos värejä on vaikea erottaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout reste lisible avec le contraste augmenté ou si vous distinguez mal les couleurs."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semuanya tetap terbaca saat Tingkatkan Kontras aktif atau jika warna sulit dibedakan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto resta leggibile con il contrasto aumentato o se fai fatica a distinguere i colori."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コントラストを上げても、色の区別が難しくても、内容をしっかり読み取れます。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Alt er fortsatt lesbart med økt kontrast på, eller hvis det er vanskelig å se forskjell på fargene."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles blijft leesbaar met Verhoog contrast aan of als kleuren moeilijk te onderscheiden zijn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystko pozostaje czytelne przy włączonym zwiększonym kontraście lub gdy trudno rozróżniać kolory."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo fica legível com o contraste aumentado ou se for difícil distinguir cores."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё хорошо читается при повышенной контрастности и когда трудно различать цвета."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Allt förblir läsbart med Öka kontrast på eller om det är svårt att skilja på färger."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อ่านได้ชัดเจนแม้เปิดการเพิ่มคอนทราสต์ หรือแยกสีได้ยาก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrastı Artır açıkken veya renkleri ayırt etmek zorsa bile her şey okunaklı kalır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi thứ vẫn dễ đọc khi bật Tăng độ tương phản hoặc khi khó phân biệt màu sắc."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无论是否增强对比度、是否难以分辨颜色，内容都清晰可读。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無論是否增加對比、是否難以分辨顏色，內容都清楚易讀。"
          }
        }
      }
    },
