    "동영상을 만들다가 문제가 생겼어요.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Erstellen des Videos ist etwas schiefgelaufen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something went wrong while making the video."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo salió mal al crear el video."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un problème est survenu pendant la création de la vidéo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualcosa è andato storto durante la creazione del video."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "動画を作る途中で問題が起きました。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo deu errado ao criar o vídeo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "制作视频时出了点问题。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "製作影片時出了點問題。"
          }
        }
      }
    },
