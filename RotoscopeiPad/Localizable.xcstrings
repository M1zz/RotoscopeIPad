    "어두운 화면에서도 글자와 단추가 또렷하게 보여요.": {
      "comment": "Roadmap item detail: dark mode",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Text a tlačítka zůstanou ostré a čitelné i na tmavé obrazovce."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekst og knapper forbliver skarpe og tydelige på en mørk skærm."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Texte und Tasten bleiben auch auf dunklem Bildschirm gut erkennbar."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα κείμενα και τα κουμπιά παραμένουν καθαρά και ευδιάκριτα σε σκούρα οθόνη."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Text and buttons stay crisp and clear on a dark screen."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Text and buttons stay crisp and clear on a dark screen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Textos y botones se ven nítidos también con la pantalla oscura."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Teksti ja painikkeet pysyvät terävinä ja selkeinä tummalla näytöllä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Textes et boutons restent bien nets sur un écran sombre."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Teks dan tombol tetap tajam dan jelas di layar gelap."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Testi e pulsanti restano nitidi anche con lo schermo scuro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "暗い画面でも、文字やボタンがくっきり見えます。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
