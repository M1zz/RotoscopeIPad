    "업데이트 뒤 처음 열 때 무엇이 새로 생겼는지 알려 줘요.": {
      "comment": "Roadmap item detail: what's new",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Při prvním otevření aplikace po aktualizaci uvidíte, co je nového."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Første gang du åbner appen efter en opdatering, kan du se, hvad der er nyt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim ersten Öffnen nach einem Update siehst du, was neu ist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Την πρώτη φορά που θα ανοίξετε την εφαρμογή μετά από μια ενημέρωση, θα δείτε τι νέο υπάρχει."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The first time you open the app after an update, you’ll see what’s new."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The first time you open the app after an update, you’ll see what’s new."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La primera vez que abras la app tras una actualización, verás las novedades."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun avaat apin ensimmäisen kerran päivityksen jälkeen, näet mitä uutta on tullut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À la première ouverture après une mise à jour, découvrez ce qui a changé."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat pertama kali membuka app setelah pembaruan, kamu akan melihat apa yang baru."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La prima volta che apri l’app dopo un aggiornamento, scopri cosa c’è di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップデート後に初めて開いたとき、新しくなった点をお知らせします。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Første gang du åpner appen etter en oppdatering, ser du hva som er nytt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De eerste keer dat je de app opent na een update, zie je wat er nieuw is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przy pierwszym otwarciu aplikacji po aktualizacji zobaczysz, co nowego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Na primeira vez que abrir o app após uma atualização, você verá as novidades."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При первом запуске после обновления вы увидите, что нового."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Första gången du öppnar appen efter en uppdatering ser du vad som är nytt."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดแอปครั้งแรกหลังอัปเดต คุณจะเห็นว่ามีอะไรใหม่"
          }
        },
        "tr": {
