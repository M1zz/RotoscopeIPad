    "다른 아이패드에서도 그리던 작품을 이어서 그려요.": {
      "comment": "Roadmap item detail: iCloud sync",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokračujte v kreslení stejného díla na jiném iPadu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tegn videre på det samme værk på en anden iPad."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Male dasselbe Werk auf einem anderen iPad einfach weiter."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Συνεχίστε να ζωγραφίζετε το ίδιο έργο σε άλλο iPad."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep drawing the same artwork on another iPad."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep drawing the same artwork on another iPad."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigue dibujando la misma obra en otro iPad."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jatka saman teoksen piirtämistä toisella iPadilla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuez la même œuvre sur un autre iPad."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lanjutkan menggambar karya yang sama di iPad lain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Continua lo stesso disegno su un altro iPad."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別のiPadでも、かきかけの作品の続きをかけます。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortsett å tegne på det samme verket på en annen iPad."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Teken verder aan hetzelfde kunstwerk op een andere iPad."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dokończ rysować tę samą pracę na innym iPadzie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue desenhando a mesma obra em outro iPad."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Продолжайте рисовать ту же работу на другом iPad."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortsätt rita på samma verk på en annan iPad."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วาดผลงานชิ้นเดิมต่อบน iPad เครื่องอื่นได้"
