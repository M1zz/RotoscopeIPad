    "사진 앱에 저장하려면 설정에서 허용해 주세요.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Chcete-li ukládat do Fotek, povolte přístup v Nastavení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillad adgang i Indstillinger for at gemme i Fotos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube in den Einstellungen den Zugriff, um in Fotos zu sichern."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Για αποθήκευση στις Φωτογραφίες, επιτρέψτε την πρόσβαση από τις Ρυθμίσεις."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To save to Photos, allow access in Settings."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "To save to Photos, allow access in Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para guardar en Fotos, permite el acceso en Configuración."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Salli pääsy Asetuksissa, jotta voit tallentaa Kuviin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour enregistrer dans Photos, autorisez l'accès dans Réglages."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk menyimpan ke Foto, izinkan akses di Pengaturan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per salvare in Foto, consenti l'accesso in Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真アプリに保存するには、設定で許可してください。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gi tilgang i Innstillinger for å lagre i Bilder."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geef toegang in Instellingen om in Foto’s te bewaren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby zapisywać w Zdjęciach, zezwól na dostęp w Ustawieniach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
