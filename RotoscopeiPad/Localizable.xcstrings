    "글자 크기를 키워도 잘리지 않고 보기 좋게 다시 배치돼요.": {
      "comment": "Roadmap item detail: Dynamic Type layouts",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Větší písmo se nikdy neuřízne — obrazovka se úhledně přeuspořádá."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Større tekst bliver aldrig klippet af – skærmen ordner sig pænt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auch mit größerer Schrift wird nichts abgeschnitten – alles ordnet sich sauber neu an."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα μεγαλύτερα γράμματα δεν κόβονται ποτέ — η οθόνη αναδιατάσσεται όμορφα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bigger text never gets cut off — the screen rearranges itself neatly."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Bigger text never gets cut off — the screen rearranges itself neatly."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aunque agrandes el texto, nada se corta y todo se reorganiza bien."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Suurempi teksti ei koskaan leikkaudu – näkymä järjestyy siististi uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Même en grand, le texte n’est jamais coupé : tout se réorganise proprement."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Teks yang lebih besar tidak akan terpotong — tampilan menyesuaikan diri dengan rapi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Anche con il testo più grande nulla viene tagliato e tutto si risistema bene."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文字を大きくしても切れずに、見やすく並び直します。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Større tekst blir aldri avkuttet – skjermen ordner seg pent."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Grotere tekst wordt nooit afgekapt — het scherm schikt zich netjes opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Większy tekst nigdy się nie ucina — ekran sam się porządnie przestawia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesmo com o texto maior, nada fica cortado e tudo se reorganiza bem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Крупный текст не обрезается — экран аккуратно перестраивается."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Större text klipps aldrig av – skärmen ordnar om sig snyggt."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตัวอักษรใหญ่แค่ไหนก็ไม่ถูกตัด หน้าจอจะจัดเรียงใหม่ให้เรียบร้อย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Büyük yazılar asla kesilmez — ekran düzenini derli toplu şekilde ayarlar."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chữ lớn đến đâu cũng không bị cắt — màn hình tự sắp xếp lại gọn gàng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调大字号后内容也不会被截断，会重新整齐排列。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "調大字級後內容也不會被截斷，會重新整齊排列。"
          }
        }
      }
    },
