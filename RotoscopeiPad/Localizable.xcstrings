    "동영상을 읽을 수 없어요. 다른 동영상으로 해볼까요?": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Video lässt sich nicht lesen. Probieren wir ein anderes?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't read this video. Want to try another one?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede leer este video. ¿Probamos con otro?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de lire cette vidéo. On essaie avec une autre ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non riesco a leggere questo video. Proviamo con un altro?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この動画は読み込めません。ほかの動画で試してみる？"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não dá para ler este vídeo. Vamos tentar outro?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "读不了这个视频。换一个试试吧？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讀不了這部影片。換一部試試看？"
          }
        }
      }
    },
    "동영상이 아니에요. 동영상을 골라 주세요!": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist kein Video. Bitte wähle ein Video aus!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That's not a video. Please pick a video!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eso no es un video. ¡Elige un video!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce n'est pas une vidéo. Choisis une vidéo !"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo non è un video. Scegli un video!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "動画ではありません。動画を選んでね！"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso não é um vídeo. Escolha um vídeo!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这不是视频，请选一个视频！"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這不是影片，請選一部影片！"
          }
        }
      }
    },
