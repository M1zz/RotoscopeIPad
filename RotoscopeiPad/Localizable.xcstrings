    "동영상, 빈 종이, 따라 그리기 중에서 골라 시작해요": {
      "comment": "First-run guide, step 1 (read by the grown-up)",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Začněte videem, prázdnou stránkou nebo sadou k obkreslování."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Start med en video, en tom side eller et tegn efter-sæt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Starte mit einem Video, einem leeren Blatt oder einem Nachzeichen-Set."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ξεκινήστε με ένα βίντεο, μια λευκή σελίδα ή ένα σετ περιγραμμάτων."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start with a video, a blank page, or a tracing set."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Start with a video, a blank page, or a tracing set."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empieza con un video, una hoja en blanco o un set para calcar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aloita videolla, tyhjällä sivulla tai jäljennyssarjalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commence avec une vidéo, une page blanche ou une série à décalquer."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mulai dari video, halaman kosong, atau set jiplakan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inizia da un video, da un foglio bianco o da un set da ricalcare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "動画、白紙、なぞり描きの中から選んで始めよう。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Start med en video, en tom side eller et tegn etter-sett."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Begin met een video, een lege pagina of een overtrekset."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zacznij od filmu, pustej strony lub zestawu do obrysowania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Comece com um vídeo, uma folha em branco ou um conjunto para decalcar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Начните с видео, чистой страницы или набора для обводки."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Börja med en video, en tom sida eller ett rita av-set."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เริ่มจากวิดีโอ กระดาษเปล่า หรือชุดวาดตามเส้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir video, boş bir sayfa veya üzerinden çizme setiyle başla."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bắt đầu bằng video, trang giấy trắng hoặc một bộ vẽ theo nét."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从视频、空白纸或描画中选一个开始吧。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從影片、空白紙或描畫中選一個開始吧。"
