    "한 번 결제로 팔랑북의 모든 기능을 계속 쓸 수 있어요.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedním nákupem odemknete v Palang Book vše, navždy."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ét køb låser alt op i Palang Book – for altid."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einmal kaufen und alle Funktionen von Palang Book dauerhaft nutzen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μία αγορά ξεκλειδώνει τα πάντα στο Palang Book, για πάντα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One purchase unlocks everything in Palang Book, for good."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "One purchase unlocks everything in Palang Book, for good."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con un solo pago, todo Palang Book es tuyo para siempre."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yksi ostos avaa kaiken Palang Bookissa, lopullisesti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un seul achat débloque tout Palang Book, pour toujours."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekali beli membuka semua yang ada di Palang Book, selamanya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con un solo acquisto sblocchi tutto Palang Book, per sempre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一度の購入で、Palang Bookのすべての機能をずっと使えます。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett kjøp låser opp alt i Palang Book – for alltid."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eén aankoop ontgrendelt alles in Palang Book, voorgoed."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeden zakup odblokowuje w Palang Book wszystko — na zawsze."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com um único pagamento, todo o Palang Book é seu para sempre."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одна покупка открывает в Palang Book всё — навсегда."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett köp låser upp allt i Palang Book – för alltid."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ซื้อครั้งเดียว ปลดล็อกทุกอย่างใน Palang Book ตลอดไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tek bir satın alma, Palang Book'taki her şeyi sonsuza dek açar."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mua một lần, mở khóa mọi thứ trong Palang Book mãi mãi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一次购买，即可永久使用 Palang Book 的全部功能。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一次購買，即可永久使用 Palang Book 的全部功能。"
          }
        }
      }
    },
    "한 번만 결제하고 구독이 아니에요. 결제는 App Store 계정으로 청구됩니다.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jednorázová platba, nejde o předplatné. Strhne se z vašeho účtu App Store."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Engangsbetaling, ikke et abonnement. Trækkes på din App Store-konto."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einmalige Zahlung, kein Abo. Die Abrechnung erfolgt über deinen App Store-Account."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εφάπαξ πληρωμή, όχι συνδρομή. Η χρέωση γίνεται στον λογαριασμό σας στο App Store."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One-time payment, not a subscription. Charged to your App Store account."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "One-time payment, not a subscription. Charged to your App Store account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pago único, no es una suscripción. Se cobrará a tu cuenta del App Store."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kertamaksu, ei tilaus. Veloitetaan App Store -tililtäsi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paiement unique, sans abonnement. Le montant est débité de votre compte App Store."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembayaran sekali saja, bukan langganan. Ditagihkan ke akun App Store kamu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pagamento unico, non è un abbonamento. L'addebito avviene sull'account App Store."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1回限りのお支払いで、サブスクリプションではありません。お支払いはApp Storeアカウントに請求されます。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Engangsbetaling, ikke et abonnement. Belastes App Store-kontoen din."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eenmalige betaling, geen abonnement. Wordt in rekening gebracht via je App Store-account."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jednorazowa płatność, nie subskrypcja. Obciążenie konta App Store."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pagamento único, não é assinatura. A cobrança é feita na sua conta da App Store."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разовый платёж, не подписка. Списывается с вашей учётной записи App Store."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Engångsbetalning, inte en prenumeration. Debiteras ditt App Store-konto."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ชำระครั้งเดียว ไม่ใช่การสมัครสมาชิก เรียกเก็บผ่านบัญชี App Store ของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tek seferlik ödeme, abonelik değildir. App Store hesabına faturalandırılır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thanh toán một lần, không phải gói đăng ký. Tính phí vào tài khoản App Store của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一次性付款，并非订阅。费用将计入你的 App Store 账户。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一次性付款，並非訂閱。費用將向你的 App Store 帳號收取。"
          }
        }
      }
    },
    "한 장을 그리고 주황 버튼을 누르면 다음 장을 그려요": {
      "comment": "First-run guide, step 2: the orange button goes to the next page",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nakresli stránku a klepnutím na oranžové tlačítko přejdi na další."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tegn én side, og tryk så på den orange knap for at tegne den næste."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Male eine Seite und tippe dann auf den orangen Knopf für die nächste."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ζωγράφισε μια σελίδα και πάτα το πορτοκαλί κουμπί για να ζωγραφίσεις την επόμενη."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Draw one page, then tap the orange button to draw the next."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Draw one page, then tap the orange button to draw the next."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dibuja una página y toca el botón naranja para dibujar la siguiente."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Piirrä yksi sivu ja napauta sitten oranssia painiketta piirtääksesi seuraavan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dessine une page, puis touche le bouton orange pour passer à la suivante."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gambar satu halaman, lalu ketuk tombol oranye untuk menggambar halaman berikutnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disegna una pagina, poi tocca il pulsante arancione per passare alla prossima."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1枚かいたら、オレンジのボタンで次のページへ。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tegn én side, og trykk så på den oransje knappen for å tegne neste."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Teken een pagina en tik dan op de oranje knop om de volgende te tekenen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Narysuj stronę, a potem dotknij pomarańczowego przycisku, aby rysować następną."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desenhe uma página e toque no botão laranja para desenhar a próxima."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нарисуйте страницу и нажмите оранжевую кнопку, чтобы рисовать следующую."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Rita en sida och tryck sedan på den orange knappen för att rita nästa."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วาดหนึ่งหน้า แล้วแตะปุ่มสีส้มเพื่อวาดหน้าถัดไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir sayfa çiz, sonra sıradakini çizmek için turuncu düğmeye dokun."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vẽ xong một trang, rồi chạm nút màu cam để vẽ trang tiếp theo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "画完一页，点橙色按钮就能画下一页。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "畫完一頁，點橘色按鈕就能畫下一頁。"
          }
        }
      }
    },
    "한 장을 다 그렸으면 주황 버튼을 눌러 다음 그림을 그려요.": {
      "comment": "Tip message over the orange next-page button",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Máš tuhle stránku hotovou? Klepni na oranžové tlačítko a kresli další obrázek."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Færdig med siden? Tryk på den orange knap for at tegne næste billede."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Seite fertig? Tippe auf den orangen Knopf und male das nächste Bild."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τελείωσες τη σελίδα; Πάτα το πορτοκαλί κουμπί για να ζωγραφίσεις την επόμενη εικόνα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finished this page? Tap the orange button to draw the next picture."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Finished this page? Tap the orange button to draw the next picture."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Terminaste esta página? Toca el botón naranja para dibujar la siguiente."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Onko sivu valmis? Napauta oranssia painiketta piirtääksesi seuraavan kuvan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Page terminée ? Touche le bouton orange pour dessiner l'image suivante."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Halaman ini sudah selesai? Ketuk tombol oranye untuk menggambar gambar berikutnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pagina finita? Tocca il pulsante arancione per disegnare la prossima."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この1枚がかけたら、オレンジのボタンで次の絵へ。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ferdig med siden? Trykk på den oransje knappen for å tegne neste bilde."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klaar met deze pagina? Tik op de oranje knop om het volgende plaatje te tekenen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gotowa strona? Dotknij pomarańczowego przycisku, aby narysować następny obrazek."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminou esta página? Toque no botão laranja para desenhar a próxima."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Закончили страницу? Нажмите оранжевую кнопку и рисуйте следующую картинку."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Klar med sidan? Tryck på den orange knappen för att rita nästa bild."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วาดหน้านี้เสร็จแล้วใช่ไหม แตะปุ่มสีส้มเพื่อวาดภาพถัดไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu sayfayı bitirdin mi? Sonraki resmi çizmek için turuncu düğmeye dokun."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vẽ xong trang này rồi? Chạm nút màu cam để vẽ tranh tiếp theo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这一页画好了？点橙色按钮接着画下一张。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這一頁畫好了？點橘色按鈕接著畫下一張。"
