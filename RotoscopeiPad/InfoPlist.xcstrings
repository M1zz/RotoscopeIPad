    "NSCameraUsageDescription": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Potřebné k natáčení videí, přes která můžete kreslit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skal bruges til at optage videoer, du kan tegne oven på."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird benötigt, um Videos zum Nachzeichnen aufzunehmen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Απαραίτητο για την εγγραφή βίντεο πάνω στα οποία μπορείτε να ζωγραφίσετε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Needed to record videos you can draw over."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Needed to record videos you can draw over."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se usa para grabar videos sobre los que dibujar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarvitaan sellaisten videoiden kuvaamiseen, joiden päälle voi piirtää."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nécessaire pour filmer des vidéos sur lesquelles dessiner."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Diperlukan untuk merekam video yang bisa digambari."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Serve per registrare video su cui disegnare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "動画を撮って、その上に絵をかくために使います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동영상을 찍어서 그림을 그리기 위해 필요해요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trengs for å ta opp videoer du kan tegne oppå."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nodig om video’s op te nemen waarover je kunt tekenen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Potrzebne do nagrywania filmów, po których można rysować."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usada para gravar vídeos e desenhar sobre eles."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нужно, чтобы снимать видео, на которых можно рисовать."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Behövs för att spela in videor som du kan rita ovanpå."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จำเป็นสำหรับถ่ายวิดีโอเพื่อวาดทับ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cần để quay video để vẽ lên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于拍摄视频，以便在上面画画。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用於拍攝影片，以便在上面畫畫。"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Potřebné k nahrávání hlasu do animací."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skal bruges til at optage stemmer til dine animationer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird benötigt, um Stimmen für Animationen aufzunehmen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Απαραίτητο για την εγγραφή φωνών στις κινούμενες εικόνες σας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Needed to record voices for your animations."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Needed to record voices for your animations."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se usa para grabar voces en tus animaciones."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarvitaan äänen tallentamiseen animaatioihisi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nécessaire pour enregistrer des voix sur vos animations."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Diperlukan untuk merekam suara untuk animasimu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Serve per registrare la voce nelle animazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アニメーションに声を録音するために使います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "애니메이션에 목소리를 녹음하기 위해 필요해요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trengs for å ta opp stemmer til animasjonene dine."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nodig om stemmen voor je animaties op te nemen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Potrzebne do nagrywania głosu do animacji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usado para gravar vozes nas suas animações."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нужно, чтобы записывать голос для анимаций."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Behövs för att spela in röster till dina animationer."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จำเป็นสำหรับบันทึกเสียงใส่ในภาพเคลื่อนไหว"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cần để ghi giọng nói cho hoạt hình của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于为动画录制声音。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用於為動畫錄製聲音。"
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Potřebné k ukládání hotových animací do Fotek."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skal bruges til at gemme færdige animationer i Fotos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird benötigt, um fertige Animationen in Fotos zu sichern."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Απαραίτητο για την αποθήκευση έτοιμων κινούμενων εικόνων στις Φωτογραφίες."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Needed to save finished animations to Photos."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Needed to save finished animations to Photos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se usa para guardar las animaciones terminadas en Fotos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarvitaan valmiiden animaatioiden tallentamiseen Kuviin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nécessaire pour enregistrer les animations terminées dans Photos."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Diperlukan untuk menyimpan animasi yang sudah jadi ke Foto."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Serve per salvare le animazioni finite in Foto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完成したアニメーションを写真アプリに保存するために使います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "완성한 애니메이션을 사진 앱에 저장하기 위해 필요해요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trengs for å lagre ferdige animasjoner i Bilder."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nodig om voltooide animaties in Foto’s te bewaren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Potrzebne do zapisywania gotowych animacji w Zdjęciach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usado para salvar as animações prontas no app Fotos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нужно, чтобы сохранять готовые анимации в «Фото»."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Behövs för att spara färdiga animationer i Bilder."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จำเป็นสำหรับบันทึกภาพเคลื่อนไหวที่เสร็จแล้วลงรูปภาพ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cần để lưu hoạt hình đã hoàn thành vào Ảnh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于将完成的动画存储到“照片”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用於將完成的動畫儲存到「照片」。"
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Potřebné k přidávání videí, přes která můžete kreslit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skal bruges til at hente videoer, du kan tegne oven på."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird benötigt, um Videos zum Nachzeichnen zu laden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Απαραίτητο για την προσθήκη βίντεο πάνω στα οποία μπορείτε να ζωγραφίσετε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Needed to bring in videos to draw over."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Needed to bring in videos to draw over."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se usa para traer videos sobre los que dibujar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarvitaan sellaisten videoiden tuomiseen, joiden päälle voi piirtää."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nécessaire pour importer des vidéos sur lesquelles dessiner."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Diperlukan untuk memasukkan video yang bisa digambari."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Serve per importare i video su cui disegnare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "絵をかく動画を読み込むために使います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그림을 그릴 동영상을 가져오기 위해 필요해요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trengs for å hente inn videoer du kan tegne oppå."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nodig om video’s toe te voegen waarover je kunt tekenen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Potrzebne do dodawania filmów, po których można rysować."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usado para trazer vídeos para desenhar por cima."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нужно, чтобы добавлять видео, на которых можно рисовать."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Behövs för att hämta in videor som du kan rita ovanpå."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จำเป็นสำหรับนำเข้าวิดีโอเพื่อวาดทับ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cần để thêm video để vẽ lên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于导入要在上面画画的视频。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用於匯入要在上面畫畫的影片。"
          }
        }
      }
    }
  },
  "version": "1.0"
}